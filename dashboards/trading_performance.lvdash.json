{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline KPIs",
      "query": "SELECT SUM(CASE WHEN exit_price IS NOT NULL THEN 1 ELSE 0 END) AS closed_trades, SUM(CASE WHEN exit_price IS NULL THEN 1 ELSE 0 END) AS open_positions, ROUND(100 * AVG(CASE WHEN exit_price IS NOT NULL THEN CASE WHEN pnl > 0 THEN 1.0 ELSE 0.0 END END), 1) AS win_rate_pct, ROUND(SUM(CASE WHEN pnl > 0 THEN pnl ELSE 0 END) / NULLIF(ABS(SUM(CASE WHEN pnl < 0 THEN pnl ELSE 0 END)), 0), 2) AS profit_factor, ROUND(100 * AVG(CASE WHEN exit_price IS NOT NULL THEN pnl_pct END), 2) AS avg_pnl_pct, ROUND(SUM(CASE WHEN exit_price IS NOT NULL THEN pnl ELSE 0 END), 2) AS total_pnl FROM bootcamp_students.trading_bd.decisions WHERE action_taken = 'BUY'"
    },
    {
      "name": "decisions_per_day",
      "displayName": "Decisions per day by outcome",
      "query": "SELECT DATE(timestamp) AS decision_date, action_taken, COUNT(*) AS decisions FROM bootcamp_students.trading_bd.decisions WHERE timestamp >= CURRENT_DATE() - INTERVAL 30 DAYS GROUP BY DATE(timestamp), action_taken ORDER BY decision_date"
    },
    {
      "name": "verdict_mix",
      "displayName": "Quant vs LLM verdict mix",
      "query": "SELECT quant_action, llm_verdict, action_taken, COUNT(*) AS decisions FROM bootcamp_students.trading_bd.decisions WHERE action_taken != 'PENDING' GROUP BY quant_action, llm_verdict, action_taken ORDER BY decisions DESC"
    },
    {
      "name": "signal_performance",
      "displayName": "Performance by signal combination",
      "query": "SELECT quant_action, llm_verdict, COUNT(*) AS trades, ROUND(100 * AVG(CASE WHEN pnl > 0 THEN 1.0 ELSE 0.0 END), 1) AS win_rate_pct, ROUND(100 * AVG(pnl_pct), 2) AS avg_pnl_pct, ROUND(SUM(CASE WHEN pnl > 0 THEN pnl ELSE 0 END) / NULLIF(ABS(SUM(CASE WHEN pnl < 0 THEN pnl ELSE 0 END)), 0), 2) AS profit_factor FROM bootcamp_students.trading_bd.decisions WHERE action_taken = 'BUY' AND exit_price IS NOT NULL GROUP BY quant_action, llm_verdict ORDER BY profit_factor DESC"
    },
    {
      "name": "open_positions",
      "displayName": "Open positions",
      "query": "SELECT ticker, DATE(timestamp) AS entry_date, ROUND(entry_price, 2) AS entry_price, ROUND(position_size, 2) AS position_size, ROUND(stop_loss_price, 2) AS stop_loss_price, DATEDIFF(CURRENT_DATE(), DATE(timestamp)) AS days_open FROM bootcamp_students.trading_bd.decisions WHERE action_taken = 'BUY' AND exit_price IS NULL ORDER BY entry_date"
    },
    {
      "name": "skip_reasons",
      "displayName": "Skip reasons (last 30 days)",
      "query": "SELECT skip_reason, COUNT(*) AS decisions, MAX(DATE(timestamp)) AS last_seen FROM bootcamp_students.trading_bd.decisions WHERE action_taken = 'SKIP' AND timestamp >= CURRENT_DATE() - INTERVAL 30 DAYS GROUP BY skip_reason ORDER BY decisions DESC"
    },
    {
      "name": "recent_closed",
      "displayName": "Recent closed trades",
      "query": "SELECT DATE(timestamp) AS entry_date, ticker, ROUND(entry_price, 2) AS entry_price, ROUND(exit_price, 2) AS exit_price, exit_reason, ROUND(pnl, 2) AS pnl, ROUND(100 * pnl_pct, 2) AS pnl_pct, hold_days FROM bootcamp_students.trading_bd.decisions WHERE exit_price IS NOT NULL ORDER BY timestamp DESC LIMIT 20"
    },
    {
      "name": "candidates_per_night",
      "displayName": "Candidates per night by tier",
      "query": "SELECT screen_date, tier, COUNT(*) AS candidates FROM bootcamp_students.trading_bd.candidates WHERE screen_date >= CURRENT_DATE() - INTERVAL 30 DAYS GROUP BY screen_date, tier ORDER BY screen_date"
    }
  ],
